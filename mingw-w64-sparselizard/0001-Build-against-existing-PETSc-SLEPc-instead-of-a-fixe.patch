+endfunction()
+
+# Bring an MSYS/Cygwin style path back to its native form.
+#
+# A PETSc or SLEPc configured from an MSYS2 shell records POSIX paths in its .pc
+# file ("/d/Work/..."), and a MUMPS reached through PETSc's private link line is
+# named the same way. A native CMake resolves none of those, and would silently
+# drop them. The /<letter>/ prefix maps to <letter>:/ and nothing else changes.
+function(_sl_native_path OUT_VAR P)
+    set(_p "${P}")
+    if(WIN32 AND NOT EXISTS "${_p}" AND _p MATCHES "^/([a-zA-Z])/(.*)$")
+        set(_p "${CMAKE_MATCH_1}:/${CMAKE_MATCH_2}")
+    endif()
+    set(${OUT_VAR} "${_p}" PARENT_SCOPE)
+endfunction()
+
+# Keep only the directories that actually exist.
+#
+# pkg-config reports whatever was baked into the .pc file at configure time. A
+# PETSc configured from an MSYS2 shell records POSIX paths ("/d/Work/..."), which
+# a native CMake cannot resolve; CMake then rejects the imported target outright.
+# Discarding the unusable entries leaves the ones found by find_path/find_library,
+# which are native by construction.
+function(_sl_existing_dirs OUT_VAR DIRS)
+    set(_kept)
+    foreach(_d IN LISTS DIRS)
+        _sl_native_path(_d "${_d}")
+        if(IS_DIRECTORY "${_d}")
+            list(APPEND _kept "${_d}")
+        endif()
+    endforeach()
+    if(_kept)
+        list(REMOVE_DUPLICATES _kept)
+    endif()
+    set(${OUT_VAR} "${_kept}" PARENT_SCOPE)
+endfunction()
+
+# Derive, from a link line, the directories that must be on the loader path at
+# run time.
+#
+# On Windows the import library and the DLL rarely sit together: oneMKL and the
+# MUMPS superbuild put the .lib in lib/ and the .dll in the sibling bin/. Both
+# candidates are therefore considered, and only the ones actually holding a
+# shared library are kept.
+#
+#   _sl_runtime_dirs(<out_var> "<link line>")
+function(_sl_runtime_dirs OUT_VAR LINE)
+    string(REPLACE " " ";" _items "${LINE}")
+    set(_cand)
+    foreach(_it IN LISTS _items)
+        if(_it MATCHES "^-L(.+)$")
+            _sl_native_path(_d "${CMAKE_MATCH_1}")
+            list(APPEND _cand "${_d}")
+        elseif(IS_ABSOLUTE "${_it}" AND _it MATCHES "\\.(lib|a|so|dylib)$")
+            _sl_native_path(_it "${_it}")
+            get_filename_component(_d "${_it}" DIRECTORY)
+            list(APPEND _cand "${_d}")
+        endif()
+    endforeach()
 
+    set(_dirs)
+    foreach(_d IN LISTS _cand)
+        get_filename_component(_parent "${_d}" DIRECTORY)
+        foreach(_try "${_d}" "${_parent}/bin")
+            if(IS_DIRECTORY "${_try}")
+                file(GLOB _shared "${_try}/*.dll" "${_try}/*.so*" "${_try}/*.dylib")
+                if(_shared)
+                    get_filename_component(_abs "${_try}" ABSOLUTE)
+                    list(APPEND _dirs "${_abs}")
+                endif()
+            endif()
+        endforeach()
+    endforeach()
+    if(_dirs)
+        list(REMOVE_DUPLICATES _dirs)
+    endif()
+    set(${OUT_VAR} "${_dirs}" PARENT_SCOPE)
+endfunction()
+
+# Turn a pkg-config style link interface into absolute library paths.
+#
+# pkg-config yields bare names ("-lpetsc"). Passing those straight to the linker
+# breaks in two common cases: the MSVC linker has no -l, and icx in its clang-cl
+# mode silently *ignores* -l and still returns 0, so a missing library surfaces
+# much later as an unresolved symbol. Resolving every name to a full path with
+# find_library keeps the behaviour identical on every toolchain.
+#
+#   _sl_resolve_libs(<out_var> "<names>" "<dirs>")
+function(_sl_resolve_libs OUT_VAR NAMES DIRS)
+    set(_resolved)
+    foreach(_name IN LISTS NAMES)
+        if(IS_ABSOLUTE "${_name}" OR _name MATCHES "\\.(lib|a|so|dylib)$")
+            list(APPEND _resolved "${_name}")
+            continue()
+        endif()
+        # "lib" prefix is not implicit for MSVC-style toolchains, hence lib${_name}.
+        find_library(_sl_lib_${_name}
+            NAMES ${_name} lib${_name}
+            HINTS ${DIRS}
+            NO_DEFAULT_PATH)
+        if(_sl_lib_${_name})
+            list(APPEND _resolved "${_sl_lib_${_name}}")
+        else()
+            find_library(_sl_sys_${_name} NAMES ${_name} lib${_name})
+            if(_sl_sys_${_name})
+                list(APPEND _resolved "${_sl_sys_${_name}}")
+            else()
+                # Leave it to the linker: system libraries such as Kernel32 have
+                # no import library to locate on the search paths we were given.
+                list(APPEND _resolved "${_name}")
+            endif()
+        endif()
+    endforeach()
+    set(${OUT_VAR} "${_resolved}" PARENT_SCOPE)
+endfunction()
diff --git a/examples/CMakeLists.txt b/examples/CMakeLists.txt
new file mode 100644
index 00000000..058b6e5b
--- /dev/null
+++ b/examples/CMakeLists.txt
@@ -0,0 +1,90 @@
+# One executable per examples/<name>/main.cpp, discovered rather than listed, so
+# that adding an example needs no edit here.
+#
+# Layout produced in the build tree:
+#
+#   bin/<name>            every executable, next to the shared library
+#   examples/<name>/      one working directory per example
+#
+# The split is forced by the examples themselves: they reference their mesh
+# relatively, as in mesh("1d.msh"), and write their results relatively too, as in
+# write(all, "u.vtu", 2). Several examples use the same file names -- disk.msh,
+# quad.msh, cmut2d.msh, u.vtu -- so a shared working directory would have them
+# overwrite each other. The binaries, on the other hand, are all unique and can
+# share one directory, which is what keeps a single copy of the shared library.
+
+file(GLOB _example_mains CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*/main.cpp")
+list(SORT _example_mains)
+
+# Loader search path for the tests. CTest applies this per test, so running an
+# example needs no prepared shell and no copied library: the third-party shared
+# libraries stay where they were installed and only their directories travel.
+if(WIN32)
+    set(_path_var PATH)
+elseif(APPLE)
+    set(_path_var DYLD_LIBRARY_PATH)
+else()
+    set(_path_var LD_LIBRARY_PATH)
+endif()
+
+set(_env_mod)
+foreach(_d IN LISTS SPARSELIZARD_RUNTIME_PATHS)
+    file(TO_NATIVE_PATH "${_d}" _nd)
+    list(APPEND _env_mod "${_path_var}=path_list_prepend:${_nd}")
+endforeach()
+
+set(_example_targets)
+
+set(_skipped_examples)
+
+foreach(_main IN LISTS _example_mains)
+    get_filename_component(_dir "${_main}" DIRECTORY)
+    get_filename_component(_name "${_dir}" NAME)
+
+    # An example that reaches for an optional dependency cannot be built when
+    # that dependency is off. Read the requirement from the source instead of
+    # maintaining a list here, so that a failure means a real defect rather than
+    # a disabled option.
+    file(READ "${_main}" _src)
+    if(_src MATCHES "gmsh\\.h" AND NOT SPARSELIZARD_ENABLE_GMSH)
+        list(APPEND _skipped_examples "${_name} (needs SPARSELIZARD_ENABLE_GMSH)")
+        continue()
+    endif()
+
+    add_executable(${_name} "${_main}")
+    target_link_libraries(${_name} PRIVATE sparselizard)
+    list(APPEND _example_targets ${_name})
+
+    # Stage the data files next to nothing but themselves.
+    set(_workdir "${CMAKE_BINARY_DIR}/examples/${_name}")
+    file(MAKE_DIRECTORY "${_workdir}")
+
+    file(GLOB _data "${_dir}/*")
+    foreach(_f IN LISTS _data)
+        if(NOT IS_DIRECTORY "${_f}" AND NOT _f STREQUAL _main)
+            get_filename_component(_fn "${_f}" NAME)
+            configure_file("${_f}" "${_workdir}/${_fn}" COPYONLY)
+        endif()
+    endforeach()
+
+    # Running an example is then a matter of ctest -R <name>, which takes care of
+    # the working directory. Started by hand it is
+    #   cd examples/<name> && ../../bin/<name>
+    add_test(NAME ${_name}
+             COMMAND $<TARGET_FILE:${_name}>
+             WORKING_DIRECTORY "${_workdir}")
+    set_tests_properties(${_name} PROPERTIES
+        ENVIRONMENT_MODIFICATION "${_env_mod}"
+        TIMEOUT 600)
+endforeach()
+
+# Convenience target: build every example without building anything else.
+if(_example_targets)
+    add_custom_target(examples DEPENDS ${_example_targets})
+    list(LENGTH _example_targets _n)
+    message(STATUS "Examples: ${_n} target(s)")
+endif()
+
+foreach(_s IN LISTS _skipped_examples)
+    message(STATUS "Examples: skipping ${_s}")
