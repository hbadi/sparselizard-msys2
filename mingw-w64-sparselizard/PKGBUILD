# Maintainer: hbadi <badi.hamid@gmail.com>

_realname=sparselizard
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
# The last tag, v.2022.05, is 65 commits behind master and predates the CMake
# build entirely: it still carries the old cMake/Setup*.cmake scheme, and none
# of the patches below applies to it. Pin the commit instead, and order the
# version so that pacman sees successive snapshots correctly.
_commit='0b826d88339f2591864f3254d2025ed49ae39275'
pkgver=2022.05.r65
pkgrel=1
pkgdesc="General purpose finite element library for multiphysics simulation (mingw-w64)"
arch=('any')
# Not mingw32: petsc and slepc are not built for it either, so the dependencies
# do not exist there.
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='http://www.sparselizard.org'
license=('spdx:GPL-2.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-openblas"
         "${MINGW_PACKAGE_PREFIX}-petsc"
         "${MINGW_PACKAGE_PREFIX}-slepc")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             'git')

source=("${_realname}::git+https://github.com/halbux/sparselizard.git#commit=${_commit}"
        '0001-Build-against-existing-PETSc-SLEPc-instead-of-a-fixe.patch'
        '0002-Drop-the-global-using-namespace-std-from-a-public-he.patch'
        '0003-Export-a-CMake-package-and-an-MSBuild-property-sheet.patch'
        '0004-Fall-back-to-PETSc-s-own-LU-when-the-requested-solve.patch'
        '0005-Find-a-PETSc-that-ships-one-library-per-variant.patch'
        '0006-Emit-the-Visual-Studio-artefacts-for-MSVC-not-for-Wi.patch')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

# What each patch is for, since a reviewer should not have to open them:
#
#  0001  replaces the ~/SLlibs layout with discovery of an existing PETSc and
#        SLEPc, which is what lets the library build against packaged ones at
#        all. Upstream's own work, carried here while it is under review.
#  0002  removes a global "using namespace std" from a public header. Without
#        it sl::integral collides with the std::integral concept, and any
#        application using integral() fails to compile: gcc 16 defaults to a
#        standard where that concept exists.
#  0003  adds install(EXPORT) and the config file, so that the package installs
#        something a consumer can find_package().
#  0004  falls back to PETSc's own LU when the requested direct solver is not
#        registered. sparselizard asks for MUMPS by name and the packaged PETSc
#        is built without it, which costs nothing at build time and returned nan
#        at the first solve.
#  0005  teaches discovery about a PETSc shipping one library per scalar type
#        and parallel model, which is how it is packaged here.
#  0006  emits the Visual Studio artefacts for MSVC rather than for Windows at
#        large, MinGW being Windows too.

prepare() {
  cd "${srcdir}/${_realname}"
  for p in "${srcdir}"/????-*.patch; do
    msg2 "Applying $(basename "${p}")"
    patch -Np1 -i "${p}"
  done
}

build() {
  # PETSc ships one library per scalar type and parallel model. dto is real
  # double with PETSc's own MPI stub and OpenMP; it is the only real double
  # variant present on every environment, the MPI ones being absent on aarch64.
  #
  # OpenMP is off for sparselizard itself: it does not need it. Its dependencies
  # are where the parallelism lives, and petsc-dto is already built with it.
  MSYS2_ARG_CONV_EXCL=-DCMAKE_INSTALL_PREFIX= \
    "${MINGW_PREFIX}/bin/cmake.exe" \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DCMAKE_BUILD_TYPE=Release \
      -DPETSC_VARIANT=dto \
      -DSPARSELIZARD_ENABLE_OPENMP=OFF \
      -DSPARSELIZARD_ENABLE_MPI=OFF \
      -DSPARSELIZARD_ENABLE_GMSH=OFF \
      -DSPARSELIZARD_BUILD_SIMULATIONS=OFF \
      -DSPARSELIZARD_BUILD_EXAMPLES=OFF \
      -S "${srcdir}/${_realname}" \
      -B "build-${MSYSTEM}"

  "${MINGW_PREFIX}/bin/cmake.exe" --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}/bin/cmake.exe" --install "build-${MSYSTEM}"

  install -Dm644 "${srcdir}/${_realname}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${srcdir}/${_realname}/COPYRIGHT" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYRIGHT"
}
